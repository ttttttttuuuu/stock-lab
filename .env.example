# Copy to .env and fill in to enable Supabase sync + frontend cloud reads.
# Without these, the system runs fully on local SQLite (data/trader.db).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # used by the Python engine to write
SUPABASE_ANON_KEY=your-anon-key              # used by the Next.js frontend to read

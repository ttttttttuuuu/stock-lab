# Copy to web/.env.local and fill in to make the dashboard read from Supabase.
# Without these, the dashboard reads the local static JSON (data exported by
# `python -m engine.export_web`). The nav bar shows which source is active.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
